{
  "name": "pyclasse-mvp",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/sync-vendor-assets.mjs",
    "assets:pwa": "node scripts/generate-pwa-icons.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/domain.test.mjs tests/contracts.test.mjs tests/i18n.test.mjs tests/infrastructure.test.mjs tests/learning-path.test.mjs",
    "test:smoke": "node --test tests/http-smoke.test.mjs",
    "test:db": "supabase test db --local supabase/tests",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/vendor",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write \"{src,lib,scripts,e2e,tests,worker}/**/*.{ts,svelte,mjs}\" \"src/**/*.css\" \"*.{ts,mjs,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{src,lib,scripts,e2e,tests,worker}/**/*.{ts,svelte,mjs}\" \"src/**/*.css\" \"*.{ts,mjs,json,md}\" \"docs/**/*.md\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:status": "supabase status"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@inlang/paraglide-js": "^2.23.1",
    "@lezer/highlight": "^1.2.1",
    "@supabase/supabase-js": "^2.111.0",
    "marked": "^18.0.9",
    "postcss": "^8.5.25",
    "pyodide": "^314.0.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-cloudflare": "^7.2.3",
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "supabase": "^2.111.0",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.2.0",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "type": "module"
}
