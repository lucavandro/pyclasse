{
  "name": "pyclasse-mvp",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/sync-vendor-assets.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/domain.test.mjs tests/contracts.test.mjs tests/infrastructure.test.mjs tests/learning-path.test.mjs",
    "test:smoke": "node --test tests/http-smoke.test.mjs",
    "test:db": "supabase test db --local supabase/tests",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/vendor",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,lib,scripts,e2e,tests,worker}/**/*.{ts,tsx,mjs}\" \"app/**/*.css\" \"*.{ts,mjs,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{app,lib,scripts,e2e,tests,worker}/**/*.{ts,tsx,mjs}\" \"app/**/*.css\" \"*.{ts,mjs,json,md}\" \"docs/**/*.md\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:status": "supabase status"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@supabase/supabase-js": "^2.111.0",
    "@uiw/react-codemirror": "^4.25.11",
    "material-symbols": "^0.45.10",
    "next": "^16.2.12",
    "postcss": "^8.5.25",
    "pyodide": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.6.2",
    "react-server-dom-webpack": "^19.2.8",
    "supabase": "^2.111.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "type": "module"
}
